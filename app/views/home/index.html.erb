<div class="container-fluid my-0 border-0">
  <nav class="navbar navbar-expand-lg bg-body-tertiary">

    <strong>
      Logged in as: <%= current_user.user_name %>
    </strong>

    <div class="ms-auto">
      <ul class="navbar-nav">
        <li class="nav-item dropdown">

          <a class="nav-link dropdown-toggle"
             href="#"
             role="button"
             data-bs-toggle="dropdown"
             aria-expanded="false">
            Account
          </a>

          <ul class="dropdown-menu dropdown-menu-end">

            <li>
              <span class="dropdown-item">
                Email: <%= current_user.email %>
              </span>
            </li>

            <li class="p-2">
              <%= button_to "Logout",
                    destroy_user_session_path,
                    method: :delete,
                    class: "btn btn-danger w-100" %>
            </li>

          </ul>

        </li>
      </ul>
    </div>

  </nav>
</div>  
<div class="container mt-5">
  <div class="card shadow mb-4">
    <div class="card-body p-4">

      <h4 class="mb-3">Search Users</h4>

      <%= form_with url: home_index_path,
            method: :get,
            data: {
              turbo_frame: "users",
              controller: "validation",
              action: "submit->validation#validate"
            } do |form| %>

        <div class="mb-3">
          <%= form.label :search,
                "Search Users by Name:",
                class: "form-label" %>

          <%= form.text_field :search,
                value: params[:search],
                class: "form-control",
                placeholder: "Enter user name",
                data: {
                  validation_target: "input"
                } %>

          <p class="text-danger mt-2"
             data-validation-target="error"></p>
        </div>

        <%= form.submit "Search",
              class: "btn btn-primary" %>

      <% end %>

    </div>
  </div>

  <!-- Users -->
  <div class="card shadow mb-4">
  <div class="card-body p-4">

    <h2 class="mb-4">Users</h2>

    <%= turbo_frame_tag "users" do %>
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>User Name</th>
            <th>Email</th>
            <th>Action</th>
          </tr>
        </thead>

        <tbody id="users">
          <%= render @users %>
        </tbody>
      </table>
    <% end %>

  </div>
</div>
</div>