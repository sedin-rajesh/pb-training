<tr id="user_<%= user.id %>">
  <td>
    <%= user.user_name %>
  </td>

  <td>
    <%= user.email %>
  </td>

  <td>
    <%= user.vendor.name%>
  </td>

  <td>
    <%= button_to "Delete",
          home_path(user),
          method: :delete,
          data: { turbo_confirm: "Are you sure?" },
          class: "btn btn-danger btn-sm" %>
  </td>
</tr>